<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
           name="item"
           type="ggack.agitpos.data.model.networkmodel.DepositModel" />
        <variable
           name="listListener"
           type="ggack.agitpos.listener.ListListener" />
        <variable
           name="date"
           type="String" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
       android:layout_width="match_parent"
       android:layout_height="40dp"
       android:orientation="horizontal"
       android:paddingStart="5dp"
       android:paddingEnd="5dp"
       tools:context=".ui.main.MainActivity">

        <TextView
           android:id="@+id/tvDate"
           android:layout_weight="1"
           android:textSize="10sp"
           android:gravity="center_vertical"
           android:layout_marginHorizontal="5dp"
           android:layout_width="match_parent"
           android:layout_height="match_parent"
           app:setDepositDateText="@{item}"/>

        <TextView
           android:id="@+id/tvMoney"
           android:layout_weight="1"
           android:text="@{Integer.toString(item.money)}"
           android:textSize="10sp"
           android:gravity="center_vertical"
           android:layout_marginHorizontal="5dp"
           android:layout_width="match_parent"
           android:layout_height="match_parent" />

        <TextView
           android:id="@+id/tvName"
           android:layout_weight="1"
           android:text="@{item.name}"
           android:textSize="10sp"
           android:gravity="center_vertical"
           android:layout_marginHorizontal="5dp"
           android:layout_width="match_parent"
           android:layout_height="match_parent" />

        <Button
           android:id="@+id/btnAdd"
           android:layout_width="50dp"
           android:layout_height="match_parent"
           android:layout_marginHorizontal="5dp"
           android:padding="0dp"
           android:textSize="10sp"
           android:text="추가"
           android:onClick="@{() -> listListener.onADD(date, item)}"

           />

        <Button
           android:id="@+id/btnSetValue"
           android:layout_width="50dp"
           android:layout_height="match_parent"
           android:layout_marginHorizontal="5dp"
           android:padding="0dp"
           android:textSize="10sp"
           android:text="설정"
           android:onClick="@{() -> listListener.onClick(date, item)}" />

        <Button
           android:id="@+id/btnDelete"
           android:layout_width="50dp"
           android:layout_height="match_parent"
           android:layout_marginHorizontal="5dp"
           android:padding="0dp"
           android:textSize="10sp"
           android:text="삭제"
           android:onClick="@{() -> listListener.onRemove(date, item)}" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>