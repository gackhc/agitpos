<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   xmlns:tools="http://schemas.android.com/tools"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
    android:padding="20dp"
   android:keepScreenOn="true"
   tools:context=".ui.view.activity.LoginActivity">
    <LinearLayout
        android:id="@+id/llName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:text="닉네임 : "
            />
        <EditText
            android:id="@+id/etNickname"
            android:layout_width="150dp"
           android:inputType="text"
            android:lines="1"
            android:textSize="20sp"
           android:imeOptions="actionNext"
           android:nextFocusForward="@id/etPin"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/llPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/llName"
        app:layout_constraintEnd_toEndOf="@id/llName">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:text="PIN : "
            />

        <EditText
           android:id="@+id/etPin"
           android:layout_width="150dp"
           android:layout_height="wrap_content"
           android:inputType="numberPassword"
           android:lines="1"
           android:maxLength="4"
           android:imeOptions="actionDone"
           android:minWidth="150dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/tv1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_marginTop="10dp"
        android:visibility="visible"
        android:textSize="15sp"
        android:text="최초 PIN : 0000"
        android:textColor="@color/red"
        app:layout_constraintTop_toBottomOf="@id/llPassword"
        app:layout_constraintEnd_toEndOf="@id/llName"/>
    <TextView
        android:id="@+id/tv2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_marginTop="50dp"
        android:visibility="gone"
        android:textColor="@color/black"
        android:text = "반드시 위 목록과 일치하는 ※닉네임※ 으로"
        app:layout_constraintTop_toBottomOf="@id/llPassword"
        app:layout_constraintEnd_toEndOf="@id/llName"/>
    <TextView
        android:id="@+id/tvBankAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:visibility="gone"
        android:textSize="22sp"
        android:textColor="@color/black"
        android:text = "카카오뱅크 3333-15-7121421 곽홍석"
        app:layout_constraintTop_toBottomOf="@id/tv2"
        app:layout_constraintEnd_toEndOf="@id/llName"/>
    <TextView
        android:id="@+id/tv3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:visibility="gone"
        android:text = "으로 입금해주세요"
        app:layout_constraintTop_toBottomOf="@id/tvBankAccount"
        app:layout_constraintEnd_toEndOf="@id/llName"/>
    <TextView
        android:id="@+id/tv4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:text = "아래 카카오페이도 됩니다(※카카오톡으로 보내시면 안됩니다.)"
        app:layout_constraintTop_toBottomOf="@id/tv3"
        app:layout_constraintEnd_toEndOf="@id/llName"/>
    <ImageView
        android:id="@+id/ivQr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:src="@drawable/qr"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/tv4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnChange"

        />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistory"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:padding="5dp"
        android:layout_height="0dp"
        android:focusable="true"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/tv1"
        app:layout_constraintBottom_toTopOf="@id/btnChange"
        />
    <Button
        android:id="@+id/btnChange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="입금 방법 보기"
        />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNickName"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintTop_toBottomOf="@id/llName"
        app:layout_constraintEnd_toEndOf="@id/llName"
        app:layout_constraintBottom_toTopOf="@id/btnChange"
        android:background="@color/gray"
        app:layout_constraintHeight_min="100dp"
        app:layout_constraintHeight_max="400dp"
        android:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>