<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View"/>
        <import type="ggack.agitpos.utils.Constants"/>
        <variable
           name="vm"
           type="ggack.agitpos.ui.main.MainViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.main.MainActivity">

        <Button
            android:id="@+id/btnUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="유저 설정"
            app:layout_constraintTop_toTopOf="parent"
           android:onClick="@{() -> vm.onStartFragment(Constants.ACTION_START_FRAGMENT_USER)}"
           />

        <Button
            android:id="@+id/btnDeposit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="입금 미일치 내역 수정"
            app:layout_constraintTop_toBottomOf="@id/btnUser"
           android:onClick="@{() -> vm.onStartFragment(Constants.ACTION_START_FRAGMENT_DEPOSIT)}" />

        <Button
            android:id="@+id/btnAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="계좌번호 설정"
            app:layout_constraintTop_toBottomOf="@id/btnDeposit"
           android:onClick="@{(view) -> vm.onSetUserAccount(view)}"/>

        <Button
            android:id="@+id/btnQR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:visibility="gone"
            android:text="카카오페이 QR 설정"
            app:layout_constraintTop_toBottomOf="@id/btnAccount"
           android:onClick="@{(view) -> vm.onSetQR(view)}"/>

        <Button
            android:id="@+id/btnCharge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:visibility="visible"
            android:text="마스터 결제"
            app:layout_constraintTop_toBottomOf="@id/btnQR"
           android:onClick="@{() -> vm.onStartFragment(Constants.ACTION_START_FRAGMENT_MASTER_CHARGE)}"/>

        <Button
            android:id="@+id/btnStatistics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:visibility="visible"
            android:text="결제 통계"
            app:layout_constraintTop_toBottomOf="@id/btnCharge"
           android:onClick="@{() -> vm.onStartFragment(Constants.ACTION_START_FRAGMENT_STATISTICS)}"/>


        <Button
            android:id="@+id/btnItemSetting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:visibility="visible"
            android:text="항목 설정"
            app:layout_constraintTop_toBottomOf="@id/btnStatistics"
           android:onClick="@{() -> vm.onStartFragment(Constants.ACTION_START_FRAGMENT_ITEMS)}"/>

        <Button
            android:id="@+id/btnAutoStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:visibility="visible"
            android:text="@{vm.liveAutoStart ? @string/autoStartUnSet : @string/autoStartSet}"
            app:layout_constraintTop_toBottomOf="@id/btnItemSetting"
            android:onClick="@{(view) -> vm.onSetAutoStart(view)}"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>