<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
           name="name"
           type="String" />
        <variable
           name="item"
           type="ggack.agitpos.data.model.networkmodel.UserModel" />
        <variable
           name="listener"
           type="ggack.agitpos.listener.ListListener" />
    </data>
    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="40dp"
       android:orientation="horizontal"
       tools:context=".ui.main.MainActivity">

        <TextView
           android:id="@+id/tvName"
           android:layout_weight="1"
           android:gravity="center_vertical"
           android:layout_marginHorizontal="5dp"
           android:layout_width="match_parent"
           android:layout_height="match_parent"
           app:name="@{name}"
           app:member='@{item.member ?? ""}'
           />

        <TextView
           android:id="@+id/tvMoney"
           android:layout_weight="1"
           android:gravity="center"
           android:text="@{Integer.toString(item.money)}"
           android:layout_marginHorizontal="5dp"
           android:layout_width="match_parent"
           android:layout_height="match_parent" />

        <Button
           android:id="@+id/btnMember"
           android:layout_width="40dp"
           android:layout_height="wrap_content"
           android:padding="0dp"
           android:textSize="8dp"
           android:layout_marginHorizontal="5dp"
           android:text="월간회원"
           android:onClick="@{()->listener.onMember(name, item)}"
           />

        <Button
           android:id="@+id/btnMoney"
           android:layout_width="40dp"
           android:layout_height="wrap_content"
           android:padding="0dp"
           android:textSize="8dp"
           android:layout_marginEnd="5dp"
           android:onClick="@{()->listener.onChange(name, item)}"
           android:text="금액수정" />

        <Button
           android:id="@+id/btnRecord"
           android:layout_width="40dp"
           android:layout_height="wrap_content"
           android:padding="0dp"
           android:textSize="8dp"
           android:onClick="@{()->listener.onRecord(name, item)}"
           android:text="기록" />

        <Button
           android:id="@+id/btnAddName"
           android:layout_width="40dp"
           android:layout_height="wrap_content"
           android:padding="0dp"
           android:layout_marginStart="5dp"
           android:textSize="8dp"
           android:onClick="@{()->listener.onADD(name, item)}"
           android:text="추가이름" />

        <Button
           android:id="@+id/btnDelete"
           android:layout_width="40dp"
           android:layout_height="wrap_content"
           android:padding="0dp"
           android:layout_marginHorizontal="5dp"
           android:onClick="@{()->listener.onRemove(name, item)}"
           android:textSize="10sp"
           android:text="삭제" />
    </LinearLayout>
</layout>